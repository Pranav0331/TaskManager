# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Email Configuration (Brevo HTTPS Transactional API)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=TaskFlow <your_verified_sender@email.com>

# CORS
CLIENT_URL=http://localhost:5173
