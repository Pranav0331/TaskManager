# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Email Configuration (Brevo HTTPS Transactional API)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=TaskFlow <your_verified_sender@email.com>

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_email@example.com

# CORS
CLIENT_URL=http://localhost:5173

